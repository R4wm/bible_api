# Server-only Stripe credential. Never use a VITE_ prefix and never commit a real key.
STRIPE_SECRET_KEY=

# Public HTTPS origin used in Checkout success and cancel return URLs.
PUBLIC_BASE_URL=https://prsmusa.com

# Durable three-year audit history and Grafana access.
POSTGRES_DB=bible_api
POSTGRES_USER=bible_api
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
