# Copy to .env (never commit the real file).
# docker compose interpolates this file automatically.

# OpenSearch 2.12+ requires this even when security is disabled.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Server-only Stripe credential. Never use a VITE_ prefix.
STRIPE_SECRET_KEY=

# Public HTTPS origin used in Checkout success/cancel URLs and OG tags.
PUBLIC_BASE_URL=https://prsmusa.com

# Optional durable analytics (compose profile "analytics"). Leave unset to
# match the live public stack: Prometheus metrics only, no Postgres.
POSTGRES_DB=bible_api
POSTGRES_USER=bible_api
POSTGRES_PASSWORD=
DATABASE_URL=
GRAFANA_ADMIN_PASSWORD=
